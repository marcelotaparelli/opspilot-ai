# Development examples only. Replace every example credential; never commit .env.
APP_ENV=development
EXPOSE_API_DOCS=false
# Passwords in these URLs must be URL encoded. The role script receives raw passwords.
POSTGRES_PASSWORD=development-admin-password
APP_DB_PASSWORD=development-app-password
DATABASE_URL=postgresql+asyncpg://opspilot_app:development-app-password@db:5432/opspilot
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:development-admin-password@db:5432/opspilot
# Token -> tenant UUID (Phase 1 form: subject derived from the token, role "agent") or
# token -> {"tenant", "subject", "roles"}. Approvers must be explicit and distinct people.
TENANT_TOKENS='{"replace-with-random-token-at-least-32-characters":{"tenant":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa","subject":"operator","roles":["agent"]},"another-random-token-at-least-32-characters":"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb","approver-random-token-at-least-32-characters":{"tenant":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa","subject":"approver","roles":["approver"]}}'
PROVIDER=fake
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
ANSWER_MODEL=gpt-4.1-mini
# Agent: per-tenant GitLab project allowlist (aliases the model may name -> numeric IDs).
AGENT_POLICY='{"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa":{"projects":{"payments-ops":{"gitlab_project_id":101,"labels":["ops","incident"],"assignees":{"approver":7}}}}}'
# Empty disables execution (approved actions fail closed with gitlab_unconfigured).
# Use https and a project-scoped token with the minimum "api" scope you can grant.
GITLAB_BASE_URL=
GITLAB_TOKEN=
# Observability (optional). Unset = no export. With `--profile observability`:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Configured prices only (JSON list); empty = cost unknown. Example entry:
# [{"provider":"openai","model":"gpt-4.1-mini","input_cost_per_million":"0.40","output_cost_per_million":"1.60","effective_from":"2026-01-01T00:00:00Z"}]
MODEL_PRICING=
