        "start",
        "approve"
      ],
      "expect": {
        "status": "succeeded",
        "issues": 1,
        "proposal": true,
        "executed": [
          "search_knowledge",
          "prepare_gitlab_issue",
          "create_gitlab_issue"
        ]
      },
      "unauthorized_attempt": false,
      "bypass_attempt": false
    },
